# Next.js frontend - LOCAL DEVELOPMENT. Copy to apps/web/.env.local
#
# Only NEXT_PUBLIC_* values are ever exposed to the browser. Backend secrets
# (SUPABASE_SERVICE_ROLE_KEY, AUTH_SECRET, ADMIN_API_KEY) must NEVER appear in
# this file or anything else inside apps/web - set them on the Render service.

# FastAPI backend URL. Local default is http://localhost:8000 (no trailing slash).
# In production, set NEXT_PUBLIC_API_URL on Vercel to your Render URL.
NEXT_PUBLIC_API_URL=https://scamsense-api.onrender.com
# Legacy name, still honoured when NEXT_PUBLIC_API_URL is unset.
# NEXT_PUBLIC_API_BASE_URL=