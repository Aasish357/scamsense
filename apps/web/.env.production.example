# Next.js frontend - PRODUCTION (Vercel)
# Configure under Vercel > Project Settings > Environment Variables.
# These values are inlined into the browser bundle at build time, so anything
# here is public. Backend secrets must not be added.

# Render backend URL, no trailing slash. Set this after the backend is deployed.
NEXT_PUBLIC_API_URL=https://scamsense-api.onrender.com

# Not used by the application: the browser never talks to Supabase directly -
# all database access goes through the FastAPI backend, which holds the
# service-role key. Documented here only so nobody adds them expecting an effect.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=