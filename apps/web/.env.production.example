# Production Next.js Frontend Environment Template (Vercel)
# Configure these variables in your Vercel Project Settings > Environment Variables

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production FastAPI backend URL (e.g. deployed on Render, Railway, or Fly.io)
# Note: The backend CORS_ORIGINS must include this Vercel domain!
NEXT_PUBLIC_API_BASE_URL=https://scamsense-api.onrender.com
