# FastAPI backend - PRODUCTION (Render service environment variables)
# None of these are ever sent to the browser.
#
#   Required,  Persistent storage (Supabase). Unset = in-memory only, and all
#               saved analyses are lost whenever the service restarts.
SUPABASE_URL=https://apfiqavifnlzloqrlwrb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFwZmlxYXZpZm5semxvcXJsd3JiIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDU4ODkxNCwiZXhwIjoyMTA2MTY0OTE0fQ.vC_BR24ti2qWadrAy-1WbXkD5ek0gVAoKsSP7TD6KX4
#
#   Required,  Comma-separated frontend origins allowed by CORS. Use your Vercel
#               URL. Never use "*": the API accepts credentials.
CORS_ORIGINS=https://your-app.vercel.app
#
#   Required,  Signs auth tokens. Render generates this automatically for the
#               Blueprint (render.yaml sets generateValue: true) - do not set it
#               by hand, or every restart invalidates all sessions.
#               Generate locally with:
#                 python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
#
#   Optional,  Admin console. Leave unset and /admin/overview returns 503.
ADMIN_API_KEY=
#
#   Optional,  Public API throttling (per client IP).
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
#
#   Optional,  Local AI. Not reachable from a cloud host, so /analyze uses the
#               deterministic engine there; keep these for local development.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_VISION_MODEL=moondream
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
#
#   Local only: uvicorn takes the port from the command line, not the environment.
PORT=8000