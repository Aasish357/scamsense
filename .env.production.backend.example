# Production FastAPI Backend Environment Template
# Duplicate this to .env in your container / host environment

# Port uvicorn listens on
PORT=8000

# Comma-separated allowed frontend origins for CORS
# e.g. https://scamsense.vercel.app,http://localhost:3000
CORS_ORIGINS=https://scamsense.vercel.app

# Supabase Credentials (server-side only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth + admin console
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_API_KEY=

# Not wired to code yet (reserved for future integrations)
OPENAI_API_KEY=
THREAT_INTEL_API_KEY=

# Local Ollama LLM (optional - /analyze falls back to heuristics when offline)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_VISION_MODEL=moondream
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
